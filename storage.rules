rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedInAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@ows\\.edu\\.ph$');
    }

    match /evidence/{allPaths=**} {
      allow read, write: if isSignedInAdmin();
    }
  }
}
