rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isProvisioned() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('^[^@]+@ows\\.edu\\.ph$')
        && exists(userProfilePath())
        && get(userProfilePath()).data.role in ['superadmin', 'counselor']
        && ((get(userProfilePath()).data.role == 'superadmin'
            && get(userProfilePath()).data.school_scope == 'all')
          || (get(userProfilePath()).data.role == 'counselor'
            && get(userProfilePath()).data.school_scope in ['elementary', 'high_school']));
    }

    function isSuperadmin() {
      return isProvisioned() && get(userProfilePath()).data.role == 'superadmin';
    }

    function isCounselor() {
      return isProvisioned() && get(userProfilePath()).data.role == 'counselor';
    }

    function isKnownScope(scope) {
      return scope in ['elementary', 'high_school', 'shared'];
    }

    function canReadScope(scope) {
      return isSuperadmin()
        || (isCounselor()
          && (scope == get(userProfilePath()).data.school_scope || scope == 'shared'));
    }

    function canWriteScope(scope) {
      return isKnownScope(scope)
        && (isSuperadmin()
          || (isCounselor()
            && (scope == get(userProfilePath()).data.school_scope || scope == 'shared')));
    }

    function scopeForGrade(yearLevel) {
      return yearLevel == 'Kindergarten'
        || yearLevel in ['1st Grade', '2nd Grade', '3rd Grade', '4th Grade', '5th Grade', '6th Grade']
        ? 'elementary'
        : yearLevel in ['7th Grade', '8th Grade', '9th Grade', '10th Grade']
          ? 'high_school'
          : 'shared';
    }

    function studentHasValidScope(data) {
      return data.year_level is string
        && data.school_scope == scopeForGrade(data.year_level);
    }

    function linkedStudentPath(data) {
      return /databases/$(database)/documents/students/$(data.student_id);
    }

    function violationMatchesCurrentStudent(data) {
      return data.student_id is string
        && exists(linkedStudentPath(data))
        && getAfter(linkedStudentPath(data)).data.school_scope == data.school_scope;
    }

    function validElementarySanctionOverrides(data) {
      return data.elementarySanctionOverrides is map
        && data.elementarySanctionOverrides.keys().hasOnly([
          'minor-light-1', 'minor-light-2', 'minor-light-3', 'minor-light-4',
          'minor-less_serious-1', 'minor-less_serious-2', 'minor-less_serious-3', 'minor-less_serious-4',
          'major-serious-1', 'major-serious-2', 'major-serious-3',
          'major-very_serious-1', 'major-very_serious-2', 'major-very_serious-3'
        ])
        && data.updated_at == request.time;
    }

    function validHighSchoolSanctionOverrides(data) {
      return data.high_schoolSanctionOverrides is map
        && data.high_schoolSanctionOverrides.keys().hasOnly([
          'minor-light-1', 'minor-light-2', 'minor-light-3', 'minor-light-4',
          'minor-less_serious-1', 'minor-less_serious-2', 'minor-less_serious-3', 'minor-less_serious-4',
          'major-serious-1', 'major-serious-2',
          'major-very_serious-1', 'major-very_serious-2'
        ])
        && data.updated_at == request.time;
    }

    match /students/{studentId} {
      allow get, list: if isProvisioned() && canReadScope(resource.data.school_scope);
      allow create: if isProvisioned()
        && canWriteScope(request.resource.data.school_scope)
        && studentHasValidScope(request.resource.data);
      allow update: if isProvisioned()
        && canReadScope(resource.data.school_scope)
        && canWriteScope(request.resource.data.school_scope)
        && studentHasValidScope(request.resource.data);
      allow delete: if isProvisioned() && canReadScope(resource.data.school_scope);
    }

    match /violations/{violationId} {
      allow get, list: if isProvisioned() && canReadScope(resource.data.school_scope);
      allow create: if isProvisioned()
        && canWriteScope(request.resource.data.school_scope)
        && violationMatchesCurrentStudent(request.resource.data);
      allow update: if isProvisioned()
        && canReadScope(resource.data.school_scope)
        && canWriteScope(request.resource.data.school_scope)
        && violationMatchesCurrentStudent(request.resource.data);
      allow delete: if isProvisioned() && canReadScope(resource.data.school_scope);
    }

    match /system_counters/{counterId} {
      allow get: if isProvisioned() && counterId == 'incident-report-sequence';
      allow create: if isProvisioned()
        && counterId == 'incident-report-sequence'
        && request.resource.data.keys().hasOnly(['last_sequence'])
        && request.resource.data.last_sequence is int
        && request.resource.data.last_sequence >= 1;
      allow update: if isProvisioned()
        && counterId == 'incident-report-sequence'
        && request.resource.data.keys().hasOnly(['last_sequence'])
        && request.resource.data.last_sequence is int
        && request.resource.data.last_sequence > resource.data.last_sequence
        && request.resource.data.last_sequence <= resource.data.last_sequence + 499;
      allow list, delete: if false;
    }

    match /rules/{ruleId} {
      allow get, list: if isProvisioned();
      allow create: if isSuperadmin()
        || (isCounselor()
          && ruleId == 'handbook_sanctions'
          && ((get(userProfilePath()).data.school_scope == 'elementary'
              && request.resource.data.keys().hasOnly(['elementarySanctionOverrides', 'updated_at'])
              && validElementarySanctionOverrides(request.resource.data))
            || (get(userProfilePath()).data.school_scope == 'high_school'
              && request.resource.data.keys().hasOnly(['high_schoolSanctionOverrides', 'updated_at'])
              && validHighSchoolSanctionOverrides(request.resource.data))));
      allow update: if isSuperadmin()
        || (isCounselor()
          && ruleId == 'handbook_sanctions'
          && ((get(userProfilePath()).data.school_scope == 'elementary'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['elementarySanctionOverrides', 'updated_at'])
              && validElementarySanctionOverrides(request.resource.data))
            || (get(userProfilePath()).data.school_scope == 'high_school'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['high_schoolSanctionOverrides', 'updated_at'])
              && validHighSchoolSanctionOverrides(request.resource.data))));
      allow delete: if isSuperadmin();
    }

    match /offense_categories/{categoryId} {
      allow get, list, create, update, delete: if isProvisioned();
    }

    match /users/{userId} {
      allow get: if isProvisioned() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /activity_logs/{activityId} {
      allow get, list: if isSuperadmin();
      allow create: if isProvisioned()
        && request.resource.data.keys().hasOnly([
          'action', 'actor_uid', 'actor_email', 'actor_role', 'school_scope',
          'target_type', 'target_id', 'source', 'created_at'
        ])
        && request.resource.data.keys().hasAll([
          'action', 'actor_uid', 'actor_email', 'actor_role', 'school_scope',
          'target_type', 'target_id', 'source', 'created_at'
        ])
        && request.resource.data.actor_uid == request.auth.uid
        && request.resource.data.actor_email == request.auth.token.email
        && request.resource.data.actor_role == get(userProfilePath()).data.role
        && request.resource.data.school_scope == get(userProfilePath()).data.school_scope
        && request.resource.data.action in [
          'login_success', 'logout', 'password_updated', 'case_recorded',
          'student_created', 'student_updated', 'student_trashed',
          'student_restored', 'student_deleted',
          'violation_recorded', 'violation_updated',
          'violation_status_updated', 'suspension_dates_updated', 'handbook_updated'
        ]
        && request.resource.data.target_type in [
          'session', 'student', 'violation', 'handbook'
        ]
        && (
          (request.resource.data.action in ['login_success', 'logout', 'password_updated']
            && request.resource.data.target_type == 'session')
          || (request.resource.data.action in [
              'student_created', 'student_updated', 'student_trashed',
              'student_restored', 'student_deleted'
            ]
            && request.resource.data.target_type == 'student')
          || (request.resource.data.action in [
              'case_recorded', 'violation_recorded', 'violation_updated',
              'violation_status_updated', 'suspension_dates_updated'
            ] && request.resource.data.target_type == 'violation')
          || (request.resource.data.action == 'handbook_updated'
            && request.resource.data.target_type == 'handbook')
        )
        && request.resource.data.target_id is string
        && request.resource.data.target_id.size() <= 128
        && request.resource.data.source == 'client'
        && request.resource.data.created_at == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
